---
import arrowUpIcon from "@phosphor-icons/core/regular/arrow-up.svg?raw";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {year} Mark Niño Tomaneng</p>
    <a class="back-to-top" href={`${base}#home`} aria-label="Back to top" title="Back to top">
      <span aria-hidden="true" set:html={arrowUpIcon}></span>
    </a>
  </div>
</footer>
