---
const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const links = [
  ["Work", `${home}#work`],
  ["Expertise", `${home}#expertise`],
  ["Approach", `${home}#approach`],
  ["Contact", `${home}#contact`]
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={home} aria-label="Mark Niño Tomaneng, home">
      <span aria-hidden="true">MT</span>
      <strong>Mark Tomaneng</strong>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
